{
  "name": "garbage-calendar-bot",
  "version": "1.0.0",
  "description": "ゴミ収集日をリマインドしてくれるカレンダーbot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "today": "ts-node src/index.ts --today",
    "tomorrow": "ts-node src/index.ts --tomorrow",
    "week": "ts-node src/index.ts --week",
    "slack:today": "ts-node src/index.ts --slack-today",
    "slack:tomorrow": "ts-node src/index.ts --slack-tomorrow",
    "generate-sample": "ts-node src/index.ts --generate-sample"
  },
  "keywords": [
    "garbage",
    "calendar",
    "bot",
    "reminder",
    "ゴミ",
    "カレンダー"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
